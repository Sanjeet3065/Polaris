// ============================================================
// POLARIS — Prisma Database Schema
// Polar Operations & Logistics Automated Remote Intelligence System
// Smart India Hackathon 2026 — Problem Statement: SIH26060
// Ministry of Earth Sciences (MoES) / NCPOR
// Target Stations: Maitri & Bharati
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum StationStatus {
  OPERATIONAL
  DEGRADED
  WARNING
  CRITICAL
  OFFLINE
}

enum EquipmentCategory {
  GENERATOR
  HVAC
  POWER_CONVERTER
  COMMUNICATION
  WATER_SYSTEM
  BATTERY
  FUEL_SYSTEM
  OTHER
}

enum EquipmentStatus {
  OPERATIONAL
  DEGRADED
  WARNING
  CRITICAL
  OFFLINE
  MAINTENANCE
}

enum AlertSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACTIVE
  ACKNOWLEDGED
  ESCALATED
  RESOLVED
  SUPPRESSED
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  MITIGATING
  RESOLVED
  CLOSED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentCategory {
  POWER
  ENERGY
  ENVIRONMENT
  EQUIPMENT
  COMMUNICATION
  INVENTORY
  LOGISTICS
  SAFETY
  OPERATIONS
  OTHER
}

enum IncidentImpact {
  NONE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  CRITICAL
  OUT_OF_STOCK
}

enum StockMovementType {
  RECEIVED
  CONSUMED
  TRANSFERRED
  ADJUSTED
  RESERVED
  RELEASED
}

enum ShipmentStatus {
  PLANNED
  READY
  IN_TRANSIT
  ARRIVED
  RECEIVED
  CANCELLED
}

enum ShipmentPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  INSPECTION
  EMERGENCY
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TelemetryStatus {
  NORMAL
  WARNING
  CRITICAL
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

// ============================================================
// CORE ENTITIES
// ============================================================

/// Indian Antarctic Research Station (Maitri / Bharati)
model Station {
  id                    String                 @id @default(uuid())
  code                  String                 @unique /// Unique station code: MAITRI, BHARATI
  name                  String                 /// Official station name
  description           String?                /// Detailed geographic & mission overview
  tagline               String?                /// Station motto or subtitle
  latitude              Float                  /// Decimal latitude coordinate (WGS84)
  longitude             Float                  /// Decimal longitude coordinate (WGS84)
  altitude              Float                  /// Altitude above sea level in meters
  timezone              String                 /// Local operating timezone (e.g. UTC+05:00 / UTC+00:00)
  status                StationStatus          @default(OPERATIONAL)
  healthPercent         Float                  @default(100.0) /// Overall station composite health index (0 - 100)
  commissionedYear      Int?                   /// Year the station was established/commissioned
  personnelCapacity     Int?                   /// Total summer bed capacity
  currentPersonnel      Int?                   /// Current active expedition members
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  // Relationships
  telemetry             StationTelemetry[]
  energyReadings        EnergyReading[]
  environmentalReadings EnvironmentalReading[]
  equipment             Equipment[]
  alerts                Alert[]
  incidents             Incident[]
  events                OperationalEvent[]
  inventory             InventoryItem[]
  inventoryMovements    InventoryMovement[]
  incomingShipments     Shipment[]             @relation("StationIncomingShipments")

  @@map("stations")
}

/// Periodic raw station telemetry observations (IoT / SCADA ingestion)
model StationTelemetry {
  id            String   @id @default(uuid())
  stationId     String
  station       Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  recordedAt    DateTime /// Timestamp of sensor measurement in UTC
  temperature   Float    /// Ambient temperature in degrees Celsius (e.g. -31.4)
  humidity      Float    /// Relative humidity percentage (0 - 100)
  pressure      Float    /// Barometric pressure in hPa
  windSpeed     Float    /// Wind speed in km/h
  windDirection Float    /// Wind direction azimuth in degrees (0 - 360)
  visibility    Float    /// Optical visibility distance in kilometers
  createdAt     DateTime @default(now())

  @@index([stationId, recordedAt])
  @@map("station_telemetry")
}

/// Power generation, consumption, battery storage & fuel reserves
model EnergyReading {
  id                String   @id @default(uuid())
  stationId         String
  station           Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  recordedAt        DateTime /// Observation timestamp in UTC
  generationKw      Float    /// Total active power generated in kW
  solarKw           Float    @default(0) /// Solar photovoltaic generation in kW
  dieselKw          Float    @default(0) /// Diesel generator power in kW
  consumptionKw     Float    /// Total load consumed by station life support & labs in kW
  netPowerKw        Float    /// Net power balance: generationKw - consumptionKw
  batteryPercent    Float    /// Main battery bank state-of-charge percentage (0 - 100)
  batteryVoltage    Float    /// Battery DC bus voltage in Volts
  fuelPercent       Float    /// Station reserve fuel storage percentage (0 - 100)
  fuelLiters        Float    @default(0) /// Usable fuel reserves in Liters
  fuelDaysRemaining Float    @default(0) /// Autonomy days remaining at current burn rate
  createdAt         DateTime @default(now())

  @@index([stationId, recordedAt])
  @@map("energy_readings")
}

/// Detailed atmospheric & microclimate readings
model EnvironmentalReading {
  id                   String          @id @default(uuid())
  stationId            String
  station              Station         @relation(fields: [stationId], references: [id], onDelete: Cascade)
  recordedAt           DateTime        /// Observation timestamp in UTC
  temperature          Float           /// Ambient temperature in degrees Celsius
  humidity             Float           /// Relative humidity percentage
  pressure             Float           /// Barometric pressure in hPa
  windSpeed            Float           /// Wind speed in km/h
  windDirection        Float           /// Wind azimuth degrees (0 - 360)
  windDirectionCompass String?         /// Cardinal direction (e.g. "SE", "NW")
  visibility           Float           /// Visibility range in kilometers
  solarRadiation       Float           @default(0) /// Solar irradiance in W/m²
  snowfallRate         Float           @default(0) /// Snow accumulation rate in mm/h
  status               TelemetryStatus @default(NORMAL)
  createdAt            DateTime        @default(now())

  @@index([stationId, recordedAt])
  @@map("environmental_readings")
}

/// Critical mechanical, electrical, and communication machinery
model Equipment {
  id                 String              @id @default(uuid())
  stationId          String
  station            Station             @relation(fields: [stationId], references: [id], onDelete: Cascade)
  code               String              /// Station-unique equipment tag (e.g. MAITRI-GEN-01)
  name               String              /// Common identifier (e.g. Primary Diesel Generator #1)
  category           EquipmentCategory
  status             EquipmentStatus     @default(OPERATIONAL)
  healthPercent      Float               @default(100.0) /// Real-time calculated health score (0 - 100)
  manufacturer       String?
  model              String?
  installedAt        DateTime?
  lastServiceAt      DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Relationships
  healthRecords      EquipmentHealth[]
  maintenanceRecords MaintenanceRecord[]
  alerts             Alert[]

  @@unique([stationId, code])
  @@index([stationId, status])
  @@map("equipment")
}

/// Historical diagnostic measurements for predictive maintenance
model EquipmentHealth {
  id            String          @id @default(uuid())
  equipmentId   String
  equipment     Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  recordedAt    DateTime        /// Diagnostic observation timestamp in UTC
  healthPercent Float           /// Health rating percentage at time of observation
  temperature   Float?          /// Operating temperature in degrees Celsius
  vibration     Float?          /// Vibration index (mm/s RMS or G)
  runtimeHours  Float?          /// Cumulative runtime hours
  status        EquipmentStatus
  notes         String?         /// Diagnostic notes or anomalous flags
  createdAt     DateTime        @default(now())

  @@index([equipmentId, recordedAt])
  @@map("equipment_health")
}

/// System, hardware, and environmental operational alerts
model Alert {
  id               String          @id @default(uuid())
  stationId        String
  station          Station         @relation(fields: [stationId], references: [id], onDelete: Cascade)
  equipmentId      String?         /// Optional link to specific malfunctioning equipment
  equipment        Equipment?      @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  severity         AlertSeverity
  title            String          /// Brief alert headline
  description      String          /// Detailed alert reason & context
  message          String?         /// Operational alert message
  status           AlertStatus     @default(OPEN)
  source           String?         /// Originating subsystem (ENERGY, ENVIRONMENT, EQUIPMENT, etc.)
  sourceType       String?         /// Source classification
  sourceId         String?         /// Source identifier (e.g. equipment code, SKU)
  ruleCode         String?         /// Deduplication rule code (e.g. ENERGY_BATTERY_LOW)
  triggerValue     Float?          /// Sensor / metric value that triggered the alert
  thresholdValue   Float?          /// Threshold exceeded
  unit             String?         /// Unit of measurement
  occurredAt       DateTime        @default(now()) /// Timestamp when anomaly occurred (UTC)
  firstDetectedAt  DateTime        @default(now())
  lastDetectedAt   DateTime        @default(now())
  acknowledgedAt   DateTime?       /// Timestamp when operator acknowledged (UTC)
  acknowledgedBy   String?         /// Operator ID or name who acknowledged
  resolvedAt       DateTime?       /// Timestamp when anomaly cleared (UTC)
  resolvedBy       String?         /// Operator ID or SYSTEM
  suppressedAt     DateTime?       /// Timestamp when alert suppressed (UTC)
  suppressedBy     String?         /// Operator ID who suppressed
  occurrenceCount  Int             @default(1)
  metadata         String?         /// JSON string of contextual parameters
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  incidentAlerts   IncidentAlert[]

  @@index([stationId, status])
  @@index([stationId, severity])
  @@index([stationId, ruleCode])
  @@index([ruleCode, status])
  @@index([occurredAt])
  @@index([lastDetectedAt])
  @@map("alerts")
}

/// High-level operational events requiring investigation, response, and resolution
model Incident {
  id                 String           @id @default(uuid())
  stationId          String
  station            Station          @relation(fields: [stationId], references: [id], onDelete: Cascade)
  incidentNumber     String           @unique /// e.g. INC-MAI-2026-001
  title              String           /// Operational headline
  description        String           /// Incident briefing & context
  severity           IncidentSeverity @default(MEDIUM)
  status             IncidentStatus   @default(OPEN)
  category           IncidentCategory @default(OPERATIONS)
  source             String?          /// Originating alert or subsystem
  startedAt          DateTime         @default(now())
  acknowledgedAt     DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  assignedTo         String?          /// Assigned operator user ID
  assignedUser       User?            @relation("IncidentAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  createdById        String?          /// Creating user ID or SYSTEM
  createdBy          User?            @relation("IncidentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  resolvedBy         String?          /// Resolving operator ID or name
  closedBy           String?          /// Closing operator ID or name
  impact             IncidentImpact   @default(MEDIUM)
  rootCause          String?          /// Root cause analysis notes
  resolutionSummary  String?          /// Summary of actions taken to resolve
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  alerts             IncidentAlert[]
  notes              IncidentNote[]

  @@index([stationId, status])
  @@index([stationId, severity])
  @@index([status])
  @@index([category])
  @@index([assignedTo])
  @@index([startedAt])
  @@map("incidents")
}

/// Explicit join relation linking alerts to higher-level operational incidents
model IncidentAlert {
  id          String   @id @default(uuid())
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  alertId     String
  alert       Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([incidentId, alertId])
  @@index([incidentId])
  @@index([alertId])
  @@map("incident_alerts")
}

/// Operational notes and log entries attached to an incident
model IncidentNote {
  id          String   @id @default(uuid())
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName  String?  /// Operator display name
  content     String   /// Log text or investigation note
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([incidentId, createdAt])
  @@map("incident_notes")
}

/// Chronological mission events and audit timeline records
model OperationalEvent {
  id          String   @id @default(uuid())
  stationId   String
  station     Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  type        String   /// Event classification (TELEMETRY, HEALTH_CHECK, BATTERY, INVENTORY, WEATHER, MAINTENANCE)
  title       String   /// Brief title of the log item
  description String   /// Full description of the event
  occurredAt  DateTime /// Event timestamp in UTC
  metadata    String?  /// JSON string containing contextual parameters if needed
  createdAt   DateTime @default(now())

  @@index([stationId, occurredAt])
  @@map("operational_events")
}

/// Station logistics, spare parts, critical reserves, and provisions
model InventoryItem {
  id               String              @id @default(uuid())
  stationId        String
  station          Station             @relation(fields: [stationId], references: [id], onDelete: Cascade)
  sku              String              /// Station-unique Stock Keeping Unit (e.g. FUEL-JET-A1)
  name             String              /// Item name (e.g. Aviation Turbine Fuel / Jet A-1)
  category         String              /// Category (Fuel, Spare Parts, Medical, Rations, Science)
  quantity         Float               /// Current available stock quantity
  unit             String              /// Unit of measurement (Liters, Units, Kg, Packs)
  minimumQuantity  Float               /// Safety threshold before triggering low-stock alert
  criticalQuantity Float?              /// Critical reserve threshold before triggering emergency alert
  reservedQuantity Float               @default(0.0) /// Stock allocated or reserved for active operations
  storageLocation  String?             /// Physical storage location (e.g. Cold Storage Bay 2, Fuel Farm Tank 1)
  description      String?             /// Technical specifications or operational notes
  status           InventoryStatus     @default(IN_STOCK)
  lastUpdatedAt    DateTime            @default(now())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  movements        InventoryMovement[]
  shipmentItems    ShipmentItem[]

  @@unique([stationId, sku])
  @@index([stationId, status])
  @@map("inventory_items")
}

/// Chronological ledger of all inventory movements and stock adjustments
model InventoryMovement {
  id            String            @id @default(uuid())
  itemId        String
  item          InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  stationId     String
  station       Station           @relation(fields: [stationId], references: [id], onDelete: Cascade)
  type          StockMovementType
  quantity      Float             /// Absolute quantity delta
  previousStock Float             /// Stock balance prior to this movement
  newStock      Float             /// Stock balance resulting from this movement
  source        String?           /// Origin location, external supply hub, or sending station
  destination   String?           /// Consuming department, destination base, or storage bay
  reference     String?           /// Associated shipment number, requisition ID, or work order
  reason        String?           /// Justification or operational context
  userId        String?           /// User who recorded or authorized the movement
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())

  @@index([itemId, createdAt])
  @@index([stationId, createdAt])
  @@index([type])
  @@map("inventory_movements")
}

/// Arctic supply movements, polar shipping manifests, and resupply voyages
model Shipment {
  id                   String           @id @default(uuid())
  shipmentNumber       String           @unique /// Unique identifier: POL-SHP-2026-01
  title                String           /// e.g. 45th ISEA Summer Resupply — MV Vasiliy Golovnin
  origin               String           /// e.g. Cape Town Port / NCPOR Goa Hub
  destinationStationId String?          /// Antarctic station destination if applicable
  destinationStation   Station?         @relation("StationIncomingShipments", fields: [destinationStationId], references: [id], onDelete: SetNull)
  destination          String           /// Destination label (e.g. Bharati Station, Maitri Station)
  status               ShipmentStatus   @default(PLANNED)
  priority             ShipmentPriority @default(NORMAL)
  plannedDeparture     DateTime?
  actualDeparture      DateTime?
  estimatedArrival     DateTime?
  actualArrival        DateTime?
  carrier              String?          /// e.g. MV Vasiliy Golovnin, IL-76TD-90VD, PistenBully 300
  notes                String?
  createdById          String?
  createdBy            User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  items                ShipmentItem[]

  @@index([destinationStationId, status])
  @@index([status])
  @@index([priority])
  @@map("shipments")
}

/// Line items / cargo manifests attached to a polar shipment
model ShipmentItem {
  id          String         @id @default(uuid())
  shipmentId  String
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  itemId      String?        /// Matched inventory catalog item ID if pre-linked
  item        InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  name        String         /// Cargo description
  category    String         /// Category
  quantity    Float          /// Total manifests quantity
  unit        String         /// Unit of measurement
  receivedQty Float          @default(0.0) /// Quantity physically verified at station receiving
  createdAt   DateTime       @default(now())

  @@index([shipmentId])
  @@map("shipment_items")
}

/// Equipment maintenance schedules, inspections, and repair logs
model MaintenanceRecord {
  id          String            @id @default(uuid())
  equipmentId String
  equipment   Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  title       String            /// Work order title
  description String            /// Work order details & scope
  type        MaintenanceType   @default(PREVENTIVE)
  status      MaintenanceStatus @default(SCHEDULED)
  scheduledAt DateTime          /// Planned maintenance window in UTC
  startedAt   DateTime?         /// Actual start time in UTC
  completedAt DateTime?         /// Actual completion time in UTC
  notes       String?           /// Post-maintenance inspection notes & technician observations
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([equipmentId, status])
  @@index([scheduledAt])
  @@map("maintenance_records")
}

// ============================================================
// AUTHENTICATION & ACCESS CONTROL (PHASE 3)
// ============================================================

/// Registered station operator, scientist, or administrative user
model User {
  id           String    @id @default(uuid())
  email        String    @unique /// Normalized lowercase email address
  passwordHash String    /// Strong cryptographic password hash (Argon2id)
  name         String    /// Full name of the user
  role         UserRole  @default(VIEWER) /// Role-Based Access Level (ADMIN, OPERATOR, VIEWER)
  isActive     Boolean   @default(true) /// Account status flag (active / deactivated)
  lastLoginAt  DateTime? /// UTC timestamp of the most recent successful login
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relationships
  sessions           Session[]
  authEvents         AuthenticationEvent[]
  inventoryMovements InventoryMovement[]
  shipmentsCreated   Shipment[]
  incidentsAssigned  Incident[]            @relation("IncidentAssignee")
  incidentsCreated   Incident[]            @relation("IncidentCreator")
  incidentNotes      IncidentNote[]

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

/// Active user refresh token session with cryptographic token rotation
model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique /// Cryptographic SHA-256 hash of the issued refresh token
  expiresAt        DateTime  /// UTC expiration timestamp
  revokedAt        DateTime? /// UTC revocation timestamp (set on logout, rotation, or security invalidation)
  userAgent        String?   /// Browser or client User-Agent string
  ipAddress        String?   /// Originating client IP address
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

/// Security audit trail for authentication, authorization, and administrative events
model AuthenticationEvent {
  id        String   @id @default(uuid())
  userId    String?  /// Nullable user identifier for failed logins or deleted accounts
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventType String   /// LOGIN_SUCCESS, LOGIN_FAILED, LOGOUT, REFRESH, TOKEN_REVOKED, PASSWORD_CHANGED, ROLE_CHANGED, USER_CREATED, USER_UPDATED, USER_STATUS_CHANGED, etc.
  success   Boolean  /// Whether the attempted action succeeded
  ipAddress String?  /// Originating client IP
  userAgent String?  /// Client User-Agent
  metadata  String?  /// Optional JSON string containing safe contextual audit data
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([eventType])
  @@index([createdAt])
  @@map("authentication_events")
}
