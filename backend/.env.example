# ============================================================
# POLARIS Backend — Environment Configuration Template
# Node.js + Express + TypeScript API & WebSocket Server
# SIH 2026 - Problem Statement ID: SIH26060
# ============================================================

# Runtime Environment
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://polaris_admin:your_secure_postgres_password_here@localhost:5432/polaris_db?schema=public

# Authentication & JWT Secrets (Must be at least 32 characters)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars_2026
JWT_REFRESH_EXPIRES_IN=7d
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:5173,http://localhost:80,https://polaris-twin.vercel.app,https://frontend-silk-iota-blp7wlwptm.vercel.app

# Real-Time WebSocket Infrastructure
WEBSOCKET_ENABLED=true
SOCKET_URL=http://localhost:5000
WEBSOCKET_HEARTBEAT_INTERVAL_MS=30000
WEBSOCKET_CONNECTION_TIMEOUT_MS=60000
WEBSOCKET_MAX_CONNECTIONS=100
WEBSOCKET_MAX_MESSAGE_SIZE=65536

# Python AI Predictive Microservice (Phase 10)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=3500

# AI Operations Assistant (Phase 12)
AI_PROVIDER=deterministic
AI_MODEL=gemini-1.5-flash
AI_API_KEY=
AI_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_MESSAGE_LENGTH=2000

# Telemetry Simulator (Phase 4)
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=5000
SIMULATOR_NOISE_LEVEL=MEDIUM
SIMULATOR_DEFAULT_SCENARIO=NORMAL

# Seed Credentials (Development & Demonstration)
SEED_ADMIN_EMAIL=admin@polaris.local
SEED_ADMIN_PASSWORD=Polaris@Admin2026!
SEED_OPERATOR_PASSWORD=Polaris@Operator2026!
SEED_VIEWER_PASSWORD=Polaris@Viewer2026!
