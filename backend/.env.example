# ============================================================
# POLARIS Backend — Environment Configuration
# Polar Operations & Logistics Automated Remote Intelligence System
# SIH 2026 - Problem Statement ID: SIH26060
# ============================================================

NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection
# Matches Docker Compose and Local Postgres Service
DATABASE_URL="postgresql://polaris_admin:polaris_secure_password@localhost:5432/polaris_db?schema=public"

# Auth & JWT Configuration
JWT_ACCESS_SECRET=polaris_super_secret_jwt_access_key_change_in_production_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=polaris_super_secret_refresh_token_key_change_in_production_2026
JWT_REFRESH_EXPIRES_IN=7d
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Admin Initial Seed Credentials (Development only)
SEED_ADMIN_EMAIL=admin@polaris.local
SEED_ADMIN_PASSWORD=Polaris@Admin2026!

AI_SERVICE_URL=http://localhost:8000
SOCKET_URL=http://localhost:5000

# Phase 12 — AI Operations Assistant Configuration
# Select 'gemini' for Google Gemini API or 'deterministic' for zero-hallucination operational synthesis
AI_PROVIDER=deterministic
AI_MODEL=gemini-1.5-flash
AI_API_KEY=
AI_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_MESSAGE_LENGTH=2000
