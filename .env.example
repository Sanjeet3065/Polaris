# ============================================================
# POLARIS — Master Environment Configuration Template
# Polar Operations & Logistics Automated Remote Intelligence System
# MoES / NCPOR (Maitri & Bharati Research Stations)
# ============================================================
# NOTICE: Copy this template to .env for local development or set
# corresponding environment variables in your production container/PaaS host.
# NEVER commit .env or real secret credentials to version control.
# ============================================================

# ------------------------------------------------------------
# 1. Global Application & Runtime Environment
# ------------------------------------------------------------
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# ------------------------------------------------------------
# 2. Relational & Time-Series Database (PostgreSQL 16)
# ------------------------------------------------------------
POSTGRES_USER=polaris_admin
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=polaris_db
POSTGRES_PORT=5432

# Connection string for Prisma ORM
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
# Inside Docker: postgresql://polaris_admin:your_secure_postgres_password_here@postgres:5432/polaris_db?schema=public
DATABASE_URL=postgresql://polaris_admin:your_secure_postgres_password_here@localhost:5432/polaris_db?schema=public

# ------------------------------------------------------------
# 3. Authentication, JWT & Security (Phase 3 & Phase 13)
# ------------------------------------------------------------
# Cryptographically secure random strings (min 32 characters)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars_2026
JWT_REFRESH_EXPIRES_IN=7d

# Set to true in production behind HTTPS to ensure cookies only transmit securely
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# ------------------------------------------------------------
# 4. Cross-Origin Resource Sharing (CORS) & Origin Security
# ------------------------------------------------------------
# Comma-separated list of authorized frontend origins
CORS_ORIGIN=http://localhost:5173,http://localhost:80,https://polaris-twin.vercel.app,https://frontend-silk-iota-blp7wlwptm.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:80,https://polaris-twin.vercel.app,https://frontend-silk-iota-blp7wlwptm.vercel.app
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------
# 5. Real-Time WebSocket Infrastructure (Phase 5)
# ------------------------------------------------------------
WEBSOCKET_ENABLED=true
SOCKET_URL=http://localhost:5000
WEBSOCKET_HEARTBEAT_INTERVAL_MS=30000
WEBSOCKET_CONNECTION_TIMEOUT_MS=60000
WEBSOCKET_MAX_CONNECTIONS=100
WEBSOCKET_MAX_MESSAGE_SIZE=65536

# ------------------------------------------------------------
# 6. Python FastAPI Predictive Maintenance Microservice (Phase 10)
# ------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=3500

# ------------------------------------------------------------
# 7. AI Operations Assistant (Phase 12)
# ------------------------------------------------------------
# Provider: 'deterministic' (recommended, zero-hallucination local engine) or 'gemini'
AI_PROVIDER=deterministic
AI_MODEL=gemini-1.5-flash
AI_API_KEY=
AI_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_MESSAGE_LENGTH=2000

# ------------------------------------------------------------
# 8. Polar Environmental & Sensor Telemetry Simulator (Phase 4)
# ------------------------------------------------------------
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=5000
SIMULATOR_NOISE_LEVEL=MEDIUM
SIMULATOR_DEFAULT_SCENARIO=NORMAL

# ------------------------------------------------------------
# 9. Database Seeding & Migrations
# ------------------------------------------------------------
RUN_MIGRATIONS=true
SEED_ON_STARTUP=false
SEED_ADMIN_EMAIL=admin@polaris.local
SEED_ADMIN_PASSWORD=Polaris@Admin2026!
SEED_OPERATOR_PASSWORD=Polaris@Operator2026!
SEED_VIEWER_PASSWORD=Polaris@Viewer2026!

# ------------------------------------------------------------
# 10. Frontend Client Variables (Vite prefixed - Public at Build Time)
# ------------------------------------------------------------
# NOTE: Frontend variables are bundled into client JavaScript. NEVER put secrets here.
VITE_API_URL=http://localhost:5000/api/v1
VITE_WS_URL=ws://localhost:5000/ws
VITE_STATION_DEFAULT=BHARATI
