# ============================================================
# POLARIS — Environment Configuration Template
# Polar Operations & Logistics Automated Remote Intelligence System
# SIH 2026 - Problem Statement ID: SIH26060
# ============================================================

# Application Environment
NODE_ENV=development

# Backend Server Configuration
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://polaris_admin:polaris_secure_password@localhost:5432/polaris_db?schema=public

# Authentication & Security
JWT_SECRET=polaris_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=polaris_super_secret_refresh_token_key_change_in_production_2026
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Real-time WebSocket Service
SOCKET_URL=http://localhost:5000
SOCKET_CORS_ORIGIN=http://localhost:5173

# AI Inference Service (Phase 10 & 12)
AI_SERVICE_URL=http://localhost:8000
AI_PROVIDER=deterministic
AI_MODEL=gemini-1.5-flash
AI_API_KEY=
AI_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_MESSAGE_LENGTH=2000

# Telemetry Simulator Settings
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=3000

# Frontend Client Variables (Vite prefixed)
VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
VITE_AI_SERVICE_URL=http://localhost:8000
VITE_STATION_DEFAULT=BHARATI
