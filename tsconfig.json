{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "embedded-postgres": [
        "./node_modules/embedded-postgres/dist/index.d.ts"
      ],
      "@prisma/client": [
        "./backend/node_modules/@prisma/client",
        "./node_modules/@prisma/client"
      ],
      ".prisma/client": [
        "./backend/node_modules/.prisma/client",
        "./node_modules/.prisma/client"
      ],
      ".prisma/client/*": [
        "./backend/node_modules/.prisma/client/*",
        "./node_modules/.prisma/client/*"
      ]
    },
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "exclude": ["frontend", "node_modules", "dist"]
}
