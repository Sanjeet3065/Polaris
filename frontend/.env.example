# ============================================================
# POLARIS Frontend — Vercel / Production Environment Variables
# ============================================================

# URL to your deployed POLARIS Backend REST API (with /api/v1 suffix)
# Example: https://polaris-backend.onrender.com/api/v1 or https://api.yourdomain.com/api/v1
VITE_API_URL=https://your-polaris-backend.onrender.com/api/v1

# URL to your deployed WebSocket Server (with /ws suffix)
# Example: wss://polaris-backend.onrender.com/ws
VITE_WS_URL=wss://your-polaris-backend.onrender.com/ws

# Optional: URL to your deployed Python FastAPI AI Service (if separated)
# Example: https://polaris-ai.onrender.com
VITE_AI_SERVICE_URL=https://your-polaris-ai.onrender.com

# Default Active Antarctic Research Station (BHARATI or MAITRI)
VITE_STATION_DEFAULT=BHARATI
